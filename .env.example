# Copy this file to .env and fill in real values before running docker compose up.
# Never commit .env to git.
#
# Only bootstrap values live here. All application secrets (API keys, DB creds,
# service tokens) are stored in Vault and fetched at runtime by vault.py.
# Run seed.sh once after `docker compose up` to populate Vault.

# ── Vault ─────────────────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root-token-changeme

# ── Postgres container bootstrap ──────────────────────────────────────────────
# Used only by the postgres container to initialize the database.
# seed.sh writes these same values into Vault so the app reads them from there.
POSTGRES_USER=concierge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=concierge

# ── MinIO container bootstrap ─────────────────────────────────────────────────
# Used only by the minio container on first start.
# seed.sh writes these same values into Vault so the app reads them from there.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
