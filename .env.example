# Copy this file to .env and fill in real values before running docker compose up.
# Only bootstrap values live here.
# Run seed.sh once after `docker compose up` to populate Vault.

# Vault
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root-token-changeme

# Postgres container bootstrap
POSTGRES_USER=concierge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=concierge

# MinIO container bootstrap
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# LangSmith tracing endpoint (non-secret; api_key and tracing_enabled go in Vault)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com