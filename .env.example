# ── Vault ─────────────────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root-token-changeme

# ── LLM provider ──────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to one of: openai | azure | groq
LLM_PROVIDER=azure

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_MAX_RETRIES=2

# Groq (LLM_PROVIDER=groq)
GROQ_API_KEY=

# ── Reranker ──────────────────────────────────────────────────────────────────
# Set RERANKER_PROVIDER to one of: llm | cohere
RERANKER_PROVIDER=llm
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast
RERANKER_TIMEOUT_SECONDS=10
RERANKER_MAX_RETRIES=2

# ── RAG retrieval ─────────────────────────────────────────────────────────────
RAG_RETRIEVAL_MODE=hybrid
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
HYBRID_VECTOR_CANDIDATE_COUNT=20
HYBRID_KEYWORD_CANDIDATE_COUNT=20

# ── Widget auth ───────────────────────────────────────────────────────────────
WIDGET_TOKEN_SECRET=
WIDGET_TOKEN_TTL_SECONDS=900
DEV_WIDGET_TENANT_ID=

# ── Postgres (Docker Compose) ─────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── MinIO (Docker Compose) ────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Guardrails (NeMo sidecar) ─────────────────────────────────────────────────
NEMO_ENABLED=true
GUARDRAILS_SERVICE_TOKEN=local-guardrails-token

# ── LangSmith tracing ─────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=concierge